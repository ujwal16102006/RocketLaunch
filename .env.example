# RocketLaunch — Environment Variables Template
# Copy this file to .env.local to enable server-side AI features.

# DeepSeek AI API Key (Required for AI Mission Intelligence features)
# Obtain your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Model Identifier (defaults to deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Launch Library 2 Base URL (defaults to official development endpoint)
NEXT_PUBLIC_LL2_ENDPOINT=https://lldev.thespacedevs.com/2.3.0/
